{
  "manifest_version": 3,
  "name": "Outlook Style for Thunderbird",
  "version": "1.0.52",
  "author": "Outlook Style for Thunderbird contributors",
  "homepage_url": "https://github.com/UbhiTS/outlook-style-for-thunderbird",
  "description": "An unofficial adaptive Outlook-style Fluent 2 theme for Mozilla Thunderbird 153 and 154.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{c53d41f1-6d13-4a72-b250-b089f6ba56a1}",
      "strict_min_version": "153.0",
      "strict_max_version": "154.*"
    }
  },
  "icons": {
    "32": "icons/fluent-mail.svg",
    "64": "icons/fluent-mail.svg",
    "128": "icons/fluent-mail.svg"
  },
  "theme_experiment": {
    "stylesheet": "styles/outlook-fluent.css",
    "colors": {
      "fluent_accent": "--outlook-accent",
      "fluent_accent_hover": "--outlook-accent-hover",
      "fluent_accent_pressed": "--outlook-accent-pressed",
      "fluent_accent_light": "--outlook-accent-light",
      "fluent_selection": "--outlook-selection",
      "fluent_surface": "--outlook-surface",
      "fluent_surface_alt": "--outlook-surface-alt",
      "fluent_surface_subtle": "--outlook-surface-subtle",
      "fluent_divider": "--outlook-divider",
      "fluent_divider_strong": "--outlook-divider-strong",
      "fluent_text": "--outlook-text",
      "fluent_text_secondary": "--outlook-text-secondary",
      "fluent_text_muted": "--outlook-text-muted"
    }
  },
  "theme": {
    "colors": {
      "frame": "#0F6CBD",
      "frame_inactive": "#3A7CB8",
      "tab_background_text": "#424242",
      "tab_background_separator": "rgba(255, 255, 255, 0.22)",
      "tab_selected": "#FFFFFF",
      "tab_text": "#242424",
      "tab_line": "#0F6CBD",
      "tab_loading": "#96C6FA",
      "toolbar": "#0F6CBD",
      "toolbar_text": "#FFFFFF",
      "icons": "#FFFFFF",
      "icons_attention": "#CFE4FA",
      "button_background_hover": "rgba(255, 255, 255, 0.14)",
      "button_background_active": "rgba(255, 255, 255, 0.24)",
      "toolbar_top_separator": "rgba(255, 255, 255, 0.14)",
      "toolbar_bottom_separator": "#0C3B5E",
      "toolbar_vertical_separator": "rgba(255, 255, 255, 0.22)",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#242424",
      "toolbar_field_border": "#D1D1D1",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#242424",
      "toolbar_field_border_focus": "#0F548C",
      "toolbar_field_highlight": "#CFE4FA",
      "toolbar_field_highlight_text": "#242424",
      "popup": "#FFFFFF",
      "popup_text": "#242424",
      "popup_border": "#D1D1D1",
      "popup_highlight": "#EBF3FC",
      "popup_highlight_text": "#242424",
      "sidebar": "#F5F5F5",
      "sidebar_text": "#242424",
      "sidebar_border": "#E0E0E0",
      "sidebar_highlight": "#EBF3FC",
      "sidebar_highlight_text": "#242424",
      "fluent_accent": "#0F6CBD",
      "fluent_accent_hover": "#115EA3",
      "fluent_accent_pressed": "#0C3B5E",
      "fluent_accent_light": "#CFE4FA",
      "fluent_selection": "#EBF3FC",
      "fluent_surface": "#FFFFFF",
      "fluent_surface_alt": "#FAFAFA",
      "fluent_surface_subtle": "#F5F5F5",
      "fluent_divider": "#E0E0E0",
      "fluent_divider_strong": "#D1D1D1",
      "fluent_text": "#242424",
      "fluent_text_secondary": "#424242",
      "fluent_text_muted": "#616161"
    },
    "properties": {
      "color_scheme": "system",
      "content_color_scheme": "system"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#0F6CBD",
      "frame_inactive": "#0C3B5E",
      "tab_background_text": "#D6D6D6",
      "tab_background_separator": "rgba(255, 255, 255, 0.18)",
      "tab_selected": "#292929",
      "tab_text": "#FFFFFF",
      "tab_line": "#479EF5",
      "tab_loading": "#62ABF5",
      "toolbar": "#0F6CBD",
      "toolbar_text": "#FFFFFF",
      "icons": "#FFFFFF",
      "icons_attention": "#CFE4FA",
      "button_background_hover": "rgba(255, 255, 255, 0.14)",
      "button_background_active": "rgba(255, 255, 255, 0.24)",
      "toolbar_top_separator": "rgba(255, 255, 255, 0.14)",
      "toolbar_bottom_separator": "#0C3B5E",
      "toolbar_vertical_separator": "rgba(255, 255, 255, 0.22)",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#242424",
      "toolbar_field_border": "#D1D1D1",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#242424",
      "toolbar_field_border_focus": "#479EF5",
      "toolbar_field_highlight": "#CFE4FA",
      "toolbar_field_highlight_text": "#242424",
      "popup": "#292929",
      "popup_text": "#FFFFFF",
      "popup_border": "#525252",
      "popup_highlight": "#082338",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#1F1F1F",
      "sidebar_text": "#FFFFFF",
      "sidebar_border": "#3D3D3D",
      "sidebar_highlight": "#082338",
      "sidebar_highlight_text": "#FFFFFF",
      "fluent_accent": "#479EF5",
      "fluent_accent_hover": "#62ABF5",
      "fluent_accent_pressed": "#2886DE",
      "fluent_accent_light": "#0F548C",
      "fluent_selection": "#082338",
      "fluent_surface": "#292929",
      "fluent_surface_alt": "#1F1F1F",
      "fluent_surface_subtle": "#141414",
      "fluent_divider": "#3D3D3D",
      "fluent_divider_strong": "#525252",
      "fluent_text": "#FFFFFF",
      "fluent_text_secondary": "#D6D6D6",
      "fluent_text_muted": "#ADADAD"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
